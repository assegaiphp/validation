{
    "name": "assegaiphp/validation",
    "description": "Rule- and attribute-based validation for PHP values and AssegaiPHP DTOs.",
    "type": "library",
    "scripts": {
        "test:unit": "codecept run Unit",
        "test": "php -d register_argc_argv=On vendor/bin/codecept run Unit",
        "hooks:install": [
            "git config core.hooksPath .githooks"
        ],
        "post-install-cmd": [
            "@hooks:install"
        ],
        "post-update-cmd": [
            "@hooks:install"
        ]
    },
    "require": {
        "php": ">=8.4",
        "arubacao/tld-checker": "^1.2",
        "giggsey/libphonenumber-for-php": "^8.13"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-phpbrowser": "*",
        "codeception/module-asserts": "*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Assegai\\Validation\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ]
}
